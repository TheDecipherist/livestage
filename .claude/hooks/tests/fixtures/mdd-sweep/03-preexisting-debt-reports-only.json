{
  "name": "reports pre-existing invalid docs without blocking when the session did not touch them",
  "stdin": {
    "hook_event_name": "Stop",
    "stop_hook_active": false
  },
  "env": {
    "MDD_DIR": ".claude/hooks/tests/fixtures/mdd-sweep/corpus-bad",
    "MDD_DOCS": ".claude/hooks/tests/fixtures/mdd-sweep/corpus-bad/docs",
    "MDD_SWEEP_TOUCHED": "none.md",
    "MDD_SRC_ROOT": ".claude/hooks/tests/fixtures/mdd-sweep/corpus-bad"
  },
  "expect_exit": 0,
  "expect_stdout_contains": [
    "pre-existing debt"
  ],
  "expect_stdout_not_contains": [
    "decision"
  ]
}