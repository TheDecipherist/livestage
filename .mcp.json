{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--viewport-size",
        "1440,1000"
      ],
      "env": {
        "DISPLAY": ":0"
      }
    }
  }
}
