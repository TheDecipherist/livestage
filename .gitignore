.ai_temp/
node_modules/
.env
.env.*
.env.local
# Deliberate exception: a secret-free, checked-in fixture for the
# env-drift example (feature 51), not a real env file.
!examples/drift/env-drift/sample-project/.env.example
dist/

# Root-level LiveStage dev config/cache, generated + local only. Anchored to
# the repo root: an unanchored `.livestage/` here would also match every
# examples/*/.livestage/ directory, silently excluding the policy.json and
# schemas/ files those examples ship WITH on purpose (found while adding
# examples/agent-briefs/: every existing example's .livestage/policy.json,
# and examples/multi-step/.livestage/schemas/pipeline-state.json, had never
# actually been committed to git, a real project-wide gap, not just this
# feature's own files).
/.livestage/

# Runtime-generated subdirs under ANY nested .livestage/ (trace logs, cache
# entries), never committed at any depth: policy.json and schemas/ under
# the same directory are NOT covered by this and stay tracked. `**/` (not
# `examples/*/`) on purpose: trace records embed the developer's absolute
# local paths and resolved directive args, a real local-info leak if ever
# committed, and a single-level pattern misses anything nested deeper than
# one example directory (e.g. examples/agent-briefs/sample-project/, or a
# future examples/foo/bar/.livestage/).
**/.livestage/trace/
**/.livestage/cache/

.vitest-results.json

# Generated by .claude/hooks/lib/conformance-gen.cjs from the rules'
# conformance: blocks; regenerate locally, never commit (its glob matches
# are project-shape-dependent and would go stale silently if checked in).
tests/conformance/

# nested git repos used as hook test fixtures
.claude/hooks/tests/fixtures/branch-guard/data-repo/
.claude/hooks/tests/fixtures/verify-no-secrets/data-clean/
.claude/hooks/tests/fixtures/verify-no-secrets/data-staged/

# Internal build-planning artifacts: the donor spec dump and the original
# wave-import plan. Referenced by path in CLAUDE.md/docs as the sole
# sanctioned place to cite the donor spec, but never shipped (package.json's
# files field is just "dist") and not meant to be public repo content.
/MDs/
/waveplan.md
.worktrees/
.mdd/*.tmp
